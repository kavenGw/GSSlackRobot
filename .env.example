# Slack Configuration (required)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# Claude Configuration
CLAUDE_COMMAND=claude
CLAUDE_TIMEOUT_MS=300000
CLAUDE_PROJECT_DIR=/path/to/your/project
CLAUDE_DANGEROUSLY_SKIP_PERMISSIONS=false
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_AUTH_TOKEN=your-anthropic-auth-token

# GitLab Webhook（设置 GITLAB_NOTIFY_CHANNEL 后启用）
GITLAB_NOTIFY_CHANNEL=C0123456789
GITLAB_WEBHOOK_PORT=3000
GITLAB_WEBHOOK_SECRET=your-gitlab-webhook-secret
GITLAB_EVENTS_PUSH=true
GITLAB_EVENTS_MR=true
GITLAB_EVENTS_PIPELINE=true
GITLAB_EVENTS_ISSUE=true
GITLAB_EVENTS_NOTE=true

# GitLab API (三个都设置时启用 GitLab 命令)
# GITLAB_API_URL=https://gitlab.example.com/api/v4
# GITLAB_TOKEN=your_gitlab_token
# GITLAB_PROJECT_ID=123

# Jenkins (三个都设置时启用 Jenkins 集成)
# JENKINS_URL=https://jenkins.example.com
# JENKINS_USERNAME=admin
# JENKINS_API_TOKEN=your_jenkins_token
# JENKINS_CRON_JOBS=FetchAllStatistics 14:00,BuildReport 18:30
